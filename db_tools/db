#!/usr/bin/env python3
"""
Herramienta de persistencia para el escritorio efímero.
Todo se guarda en PostgreSQL (DATABASE_URL) para no perder nada.
"""

import os
import sys
import base64
from pathlib import Path

try:
    import psycopg2
    from psycopg2.extras import RealDictCursor
except ImportError:
    print("ERROR: psycopg2 no está instalado. Ejecuta: pip3 install psycopg2-binary")
    sys.exit(1)

DATABASE_URL = os.environ.get("DATABASE_URL")
if not DATABASE_URL:
    print("ERROR: No existe la variable DATABASE_URL.")
    print("Asegúrate de tener el add-on PostgreSQL de Render conectado.")
    sys.exit(1)

def get_conn():
    return psycopg2.connect(DATABASE_URL)

def init_db():
    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("""
                CREATE TABLE IF NOT EXISTS virtual_files (
                    path TEXT PRIMARY KEY,
                    content TEXT NOT NULL,
                    is_binary BOOLEAN DEFAULT FALSE,
                    updated_at TIMESTAMPTZ DEFAULT NOW()
                );
            """)
            cur.execute("""
                CREATE TABLE IF NOT EXISTS installed_packages (
                    name TEXT PRIMARY KEY,
                    added_at TIMESTAMPTZ DEFAULT NOW()
                );
            """)
            cur.execute("""
                CREATE TABLE IF NOT EXISTS key_value (
                    key TEXT PRIMARY KEY,
                    value TEXT,
                    updated_at TIMESTAMPTZ DEFAULT NOW()
                );
            """)
        conn.commit()
    print("✓ Tablas creadas / verificadas en PostgreSQL")

def save_file(local_path, remote_path=None):
    local = Path(local_path).expanduser().resolve()
    if not local.exists():
        print(f"ERROR: No existe el archivo {local}")
        sys.exit(1)

    remote = remote_path or str(local)
    data = local.read_bytes()

    # Detectar si es binario
    is_binary = b"\x00" in data[:1024]
    if is_binary:
        content = base64.b64encode(data).decode("ascii")
    else:
        try:
            content = data.decode("utf-8")
        except UnicodeDecodeError:
            content = base64.b64encode(data).decode("ascii")
            is_binary = True

    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("""
                INSERT INTO virtual_files (path, content, is_binary, updated_at)
                VALUES (%s, %s, %s, NOW())
                ON CONFLICT (path) DO UPDATE
                SET content = EXCLUDED.content,
                    is_binary = EXCLUDED.is_binary,
                    updated_at = NOW()
            """, (remote, content, is_binary))
        conn.commit()
    print(f"✓ Guardado en BD: {remote}")

def load_file(remote_path, local_path=None):
    local = Path(local_path or remote_path).expanduser()
    with get_conn() as conn:
        with conn.cursor(cursor_factory=RealDictCursor) as cur:
            cur.execute("SELECT content, is_binary FROM virtual_files WHERE path = %s", (remote_path,))
            row = cur.fetchone()

    if not row:
        print(f"ERROR: No existe en la BD: {remote_path}")
        sys.exit(1)

    local.parent.mkdir(parents=True, exist_ok=True)
    if row["is_binary"]:
        data = base64.b64decode(row["content"])
        local.write_bytes(data)
    else:
        local.write_text(row["content"], encoding="utf-8")
    print(f"✓ Recuperado: {remote_path} → {local}")

def list_files():
    with get_conn() as conn:
        with conn.cursor(cursor_factory=RealDictCursor) as cur:
            cur.execute("SELECT path, is_binary, updated_at FROM virtual_files ORDER BY path")
            rows = cur.fetchall()
    if not rows:
        print("(no hay archivos guardados)")
        return
    print(f"{'Ruta':<50} {'Tipo':<10} Actualizado")
    print("-" * 80)
    for r in rows:
        tipo = "binario" if r["is_binary"] else "texto"
        print(f"{r['path']:<50} {tipo:<10} {r['updated_at']}")

def pkg_add(name):
    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("""
                INSERT INTO installed_packages (name) VALUES (%s)
                ON CONFLICT (name) DO NOTHING
            """, (name,))
        conn.commit()
    print(f"✓ Paquete marcado para reinstalar: {name}")
    print("  (ejecuta 'db restore' después de reiniciar para instalarlo)")

def pkg_list():
    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("SELECT name FROM installed_packages ORDER BY name")
            rows = cur.fetchall()
    if not rows:
        print("(ningún paquete marcado)")
        return
    for (name,) in rows:
        print(f"  - {name}")

def restore():
    print("→ Restaurando desde PostgreSQL...")
    # 1. Paquetes
    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("SELECT name FROM installed_packages")
            packages = [r[0] for r in cur.fetchall()]

    if packages:
        print(f"  Instalando paquetes: {', '.join(packages)}")
        os.system(f"sudo apk add --no-cache {' '.join(packages)}")
    else:
        print("  (ningún paquete para instalar)")

    # 2. Archivos
    with get_conn() as conn:
        with conn.cursor(cursor_factory=RealDictCursor) as cur:
            cur.execute("SELECT path, content, is_binary FROM virtual_files")
            files = cur.fetchall()

    for f in files:
        local = Path(f["path"]).expanduser()
        try:
            local.parent.mkdir(parents=True, exist_ok=True)
            if f["is_binary"]:
                local.write_bytes(base64.b64decode(f["content"]))
            else:
                local.write_text(f["content"], encoding="utf-8")
            print(f"  ✓ {f['path']}")
        except Exception as e:
            print(f"  ✗ {f['path']}: {e}")

    print("✓ Restauración terminada")

def usage():
    print("""Uso: db <comando> [argumentos]

Comandos:
  init                     Crea las tablas en PostgreSQL (hazlo una vez)
  save <archivo> [ruta]    Guarda un archivo en la base de datos
  load <ruta> [archivo]    Recupera un archivo de la base de datos
  list                     Lista todos los archivos guardados
  pkg add <paquete>        Marca un paquete apk para reinstalar
  pkg list                 Lista paquetes marcados
  restore                  Reinstala paquetes + recupera todos los archivos

Ejemplos:
  db init
  db save ~/miscript.py
  db save /etc/mi-config.conf configs/mi-config.conf
  db load configs/mi-config.conf
  db pkg add htop
  db restore
""")

def main():
    if len(sys.argv) < 2:
        usage()
        sys.exit(0)

    cmd = sys.argv[1]

    if cmd == "init":
        init_db()
    elif cmd == "save":
        if len(sys.argv) < 3:
            print("Uso: db save <archivo> [ruta_en_bd]")
            sys.exit(1)
        save_file(sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else None)
    elif cmd == "load":
        if len(sys.argv) < 3:
            print("Uso: db load <ruta_en_bd> [archivo_local]")
            sys.exit(1)
        load_file(sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else None)
    elif cmd == "list":
        list_files()
    elif cmd == "pkg":
        if len(sys.argv) < 3:
            print("Uso: db pkg add|list [paquete]")
            sys.exit(1)
        sub = sys.argv[2]
        if sub == "add" and len(sys.argv) >= 4:
            pkg_add(sys.argv[3])
        elif sub == "list":
            pkg_list()
        else:
            print("Uso: db pkg add <paquete>  |  db pkg list")
    elif cmd == "restore":
        restore()
    else:
        usage()

if __name__ == "__main__":
    main()
