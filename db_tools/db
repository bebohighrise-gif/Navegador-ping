#!/usr/bin/env python3
"""
Herramienta de persistencia — guarda/recupera en PostgreSQL.
El autosave ya guarda solo; esto es para uso manual extra.
"""

import os
import sys
import base64
from pathlib import Path

try:
    import psycopg2
    from psycopg2.extras import RealDictCursor
except ImportError:
    print("ERROR: psycopg2 no disponible")
    sys.exit(1)

DATABASE_URL = os.environ.get("DATABASE_URL")
if not DATABASE_URL:
    print("ERROR: No existe DATABASE_URL")
    sys.exit(1)

HOME = Path(os.environ.get("HOME", "/home/desktop"))

def get_conn():
    return psycopg2.connect(DATABASE_URL)

def init_db():
    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("""
                CREATE TABLE IF NOT EXISTS virtual_files (
                    path TEXT PRIMARY KEY,
                    content TEXT NOT NULL,
                    is_binary BOOLEAN DEFAULT FALSE,
                    updated_at TIMESTAMPTZ DEFAULT NOW()
                );
            """)
            cur.execute("""
                CREATE TABLE IF NOT EXISTS installed_packages (
                    name TEXT PRIMARY KEY,
                    manager TEXT DEFAULT 'apk',
                    added_at TIMESTAMPTZ DEFAULT NOW()
                );
            """)
            cur.execute("""
                CREATE TABLE IF NOT EXISTS key_value (
                    key TEXT PRIMARY KEY,
                    value TEXT,
                    updated_at TIMESTAMPTZ DEFAULT NOW()
                );
            """)
        conn.commit()
    print("✓ Tablas listas en PostgreSQL")

def save_file(local_path, remote_path=None):
    local = Path(local_path).expanduser()
    if not local.is_absolute():
        local = (Path.cwd() / local).resolve()
    if not local.exists():
        print(f"ERROR: No existe {local}")
        sys.exit(1)

    # Ruta en BD relativa a home si es posible
    try:
        rel = local.relative_to(HOME)
        remote = remote_path or f"home/{rel}"
    except ValueError:
        remote = remote_path or str(local)

    data = local.read_bytes()
    is_binary = b"\x00" in data[:1024]
    if is_binary:
        content = base64.b64encode(data).decode("ascii")
    else:
        try:
            content = data.decode("utf-8")
        except UnicodeDecodeError:
            content = base64.b64encode(data).decode("ascii")
            is_binary = True

    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("""
                INSERT INTO virtual_files (path, content, is_binary, updated_at)
                VALUES (%s, %s, %s, NOW())
                ON CONFLICT (path) DO UPDATE
                SET content = EXCLUDED.content,
                    is_binary = EXCLUDED.is_binary,
                    updated_at = NOW()
            """, (remote, content, is_binary))
        conn.commit()
    print(f"✓ Guardado: {remote}")

def load_file(remote_path, local_path=None):
    with get_conn() as conn:
        with conn.cursor(cursor_factory=RealDictCursor) as cur:
            cur.execute("SELECT content, is_binary FROM virtual_files WHERE path = %s", (remote_path,))
            row = cur.fetchone()

    if not row:
        print(f"ERROR: No existe en BD: {remote_path}")
        sys.exit(1)

    if local_path:
        local = Path(local_path).expanduser()
    elif remote_path.startswith("home/"):
        local = HOME / remote_path[5:]
    else:
        local = Path(remote_path).expanduser()

    local.parent.mkdir(parents=True, exist_ok=True)
    if row["is_binary"]:
        local.write_bytes(base64.b64decode(row["content"]))
    else:
        local.write_text(row["content"], encoding="utf-8")
    print(f"✓ Recuperado: {remote_path} → {local}")

def list_files():
    with get_conn() as conn:
        with conn.cursor(cursor_factory=RealDictCursor) as cur:
            cur.execute("SELECT path, is_binary, updated_at FROM virtual_files ORDER BY path")
            rows = cur.fetchall()
    if not rows:
        print("(vacío)")
        return
    for r in rows:
        tipo = "bin" if r["is_binary"] else "txt"
        print(f"  [{tipo}] {r['path']}")

def pkg_add(name, manager="apk"):
    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("""
                INSERT INTO installed_packages (name, manager) VALUES (%s, %s)
                ON CONFLICT (name) DO UPDATE SET manager = EXCLUDED.manager
            """, (name, manager))
        conn.commit()
    print(f"✓ Marcado para reinstalar: {name} ({manager})")

def pkg_list():
    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("SELECT name, manager FROM installed_packages ORDER BY name")
            rows = cur.fetchall()
    if not rows:
        print("(ninguno)")
        return
    for name, manager in rows:
        print(f"  - {name} [{manager}]")

def restore():
    print("→ Restaurando desde PostgreSQL...")

    # Paquetes
    with get_conn() as conn:
        with conn.cursor() as cur:
            cur.execute("SELECT name, manager FROM installed_packages")
            packages = cur.fetchall()

    for name, manager in packages:
        try:
            if manager == "apk":
                os.system(f"sudo apk add --no-cache {name} 2>/dev/null")
            elif manager == "pip":
                os.system(f"pip3 install --user {name} 2>/dev/null")
            elif manager == "npm":
                os.system(f"npm install -g {name} 2>/dev/null")
            print(f"  ✓ paquete {name}")
        except Exception:
            print(f"  ✗ paquete {name}")

    # Archivos
    with get_conn() as conn:
        with conn.cursor(cursor_factory=RealDictCursor) as cur:
            cur.execute("SELECT path, content, is_binary FROM virtual_files")
            files = cur.fetchall()

    for f in files:
        try:
            p = f["path"]
            if p.startswith("home/"):
                local = HOME / p[5:]
            else:
                local = Path(p).expanduser()
            local.parent.mkdir(parents=True, exist_ok=True)
            if f["is_binary"]:
                local.write_bytes(base64.b64decode(f["content"]))
            else:
                local.write_text(f["content"], encoding="utf-8")
            print(f"  ✓ {p}")
        except Exception as e:
            print(f"  ✗ {f['path']}: {e}")

    print("✓ Restauración terminada")

def usage():
    print("""db — persistencia en PostgreSQL (también hay autosave automático)

  db init
  db save <archivo>
  db load <ruta_en_bd>
  db list
  db pkg add <paquete> [apk|pip|npm]
  db pkg list
  db restore
""")

def main():
    if len(sys.argv) < 2:
        usage()
        return
    cmd = sys.argv[1]
    if cmd == "init":
        init_db()
    elif cmd == "save":
        if len(sys.argv) < 3:
            print("Uso: db save <archivo>")
            sys.exit(1)
        save_file(sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else None)
    elif cmd == "load":
        if len(sys.argv) < 3:
            print("Uso: db load <ruta>")
            sys.exit(1)
        load_file(sys.argv[2], sys.argv[3] if len(sys.argv) > 3 else None)
    elif cmd == "list":
        list_files()
    elif cmd == "pkg":
        if len(sys.argv) < 3:
            print("Uso: db pkg add|list ...")
            sys.exit(1)
        sub = sys.argv[2]
        if sub == "add" and len(sys.argv) >= 4:
            mgr = sys.argv[4] if len(sys.argv) > 4 else "apk"
            pkg_add(sys.argv[3], mgr)
        elif sub == "list":
            pkg_list()
        else:
            print("Uso: db pkg add <nombre> [apk|pip|npm]")
    elif cmd == "restore":
        restore()
    else:
        usage()

if __name__ == "__main__":
    main()
