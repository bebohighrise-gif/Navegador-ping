#!/bin/bash
# Helper rápido para PostgreSQL.
# Uso:
#   db                  → psql interactivo
#   db "SELECT 1"       → ejecuta query y sale
#   db -c "SELECT 1"

set -e

if [ -z "$DATABASE_URL" ]; then
  echo "DATABASE_URL no está definida." >&2
  exit 1
fi

if [ $# -eq 0 ]; then
  exec psql "$DATABASE_URL"
elif [ "$1" = "-c" ]; then
  shift
  exec psql "$DATABASE_URL" -c "$*"
else
  exec psql "$DATABASE_URL" -c "$*"
fi
